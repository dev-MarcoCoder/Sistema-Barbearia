# Chave do OpenRouter para o assistente de agendamento (chat com IA).
#
# 1. Crie uma chave em https://openrouter.ai/settings/keys
# 2. Copie este arquivo para ia.properties (na mesma pasta) e cole a chave abaixo.
# 3. Reinicie a aplicação no Tomcat.
#
# O ia.properties está no .gitignore: a chave nunca vai para o repositório.
# Sem a chave, o site funciona normalmente e o chat mostra um aviso.
openrouter.api_key=

# Modelo usado pelo chat (opcional). Padrão: Claude Haiku 5.5, o mais barato da Anthropic.
openrouter.modelo=anthropic/claude-haiku-5.5
