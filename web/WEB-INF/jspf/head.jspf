<%-- Conteudo comum do <head>. A pagina que inclui precisa definir a variavel tituloPagina. --%>
<%@page import="br.com.barbearia.util.Html"%>
<%
    String ctx = request.getContextPath();
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="BarberAgenda: agendamento online de cortes de cabelo para barbearias.">
<title><%= Html.esc(tituloPagina) %> · BarberAgenda</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%23d4a64a'/%3E%3Ctext x='50' y='70' font-size='60' text-anchor='middle'%3E%E2%9C%82%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="<%= ctx %>/css/estilo.css">
