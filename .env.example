# Copie para .env (no servidor) e preencha. O .env NUNCA vai para o Git.
#   cp .env.example .env && nano .env

# Senha do administrador do MySQL (invente uma forte, sem espacos)
MYSQL_ROOT_PASSWORD=

# Senha do usuario que o site usa para acessar o banco (invente outra)
DB_SENHA=

# Endereco do site (ex.: meubarberagenda.duckdns.org). Com ele, o HTTPS e ativado sozinho.
DOMINIO=

# Chave do OpenRouter (comeca com sk-or-). Sem ela o site funciona, mas o chat fica desligado.
OPENROUTER_API_KEY=

# Modelo do chat (opcional). Padrao: Claude Haiku 5.5
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
